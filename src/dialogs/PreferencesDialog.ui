         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QComboBox" name="enterSendsCombo"/>
       </item>
       <item row="1" column="1">
        <widget class="QCheckBox" name="backspaceDeleteCheck">
         <property name="toolTip">
          <string>Checked: Backspace sends DEL (0x7F), as Linux consoles expect. Unchecked: BS (0x08).</string>
         </property>
         <property name="text">
          <string>Backspace sends DEL (0x7F) instead of BS (0x08)</string>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QCheckBox" name="localEchoCheck">
