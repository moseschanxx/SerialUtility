           <property name="text">
            <string>Shortcut:</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QKeySequenceEdit" name="shortcutEdit">
           <property name="toolTip">
            <string>Press the key combination for the selected action.</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="shortcutClearButton">
           <property name="toolTip">
            <string>Remove the shortcut of the selected action.</string>
           </property>
           <property name="text">
            <string>Clear</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="shortcutRestoreButton">
           <property name="toolTip">
            <string>Put the selected action back to its default shortcut.</string>
           </property>
           <property name="text">
            <string>Restore Default</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="shortcutConflictLabel">
