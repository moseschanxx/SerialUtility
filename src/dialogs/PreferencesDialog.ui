   </rect>
  </property>
  <property name="windowTitle">
   <string>Preferences</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="tabTerminal">
      <attribute name="title">
       <string>Terminal</string>
      </attribute>
      <layout class="QFormLayout" name="terminalForm">
       <item row="0" column="0">
        <widget class="QLabel" name="fontLabel">
         <property name="text">
          <string>Font:</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <layout class="QHBoxLayout" name="fontLayout">
         <item>
          <widget class="QLabel" name="fontPreviewLabel">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="frameShape">
            <enum>QFrame::Shape::StyledPanel</enum>
           </property>
           <property name="text">
            <string>Consolas 10</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="fontButton">
           <property name="text">
            <string>Choose...</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="themeLabel">
         <property name="text">
          <string>Colour theme:</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QComboBox" name="themeCombo"/>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="scrollbackLabel">
         <property name="text">
          <string>Scrollback lines:</string>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QSpinBox" name="scrollbackSpin">
         <property name="minimum">
          <number>100</number>
         </property>
         <property name="maximum">
          <number>1000000</number>
         </property>
         <property name="singleStep">
          <number>1000</number>
         </property>
         <property name="value">
          <number>10000</number>
         </property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="QCheckBox" name="cursorBlinkCheck">
         <property name="text">
          <string>Blinking cursor</string>
         </property>
        </widget>
       </item>
       <item row="4" column="1">
        <widget class="QCheckBox" name="bellCheck">
         <property name="text">
          <string>Bell on BEL (0x07)</string>
         </property>
        </widget>
       </item>
       <item row="5" column="1">
        <widget class="QCheckBox" name="implicitCrCheck">
         <property name="toolTip">
          <string>Treat a bare line feed as CR+LF. Fixes &quot;staircase&quot; output from MCU firmware that only sends \n.</string>
         </property>
         <property name="text">
          <string>Implicit carriage return on line feed</string>
         </property>
        </widget>
       </item>
       <item row="6" column="1">
        <widget class="QCheckBox" name="pauseWhileSelectingCheck">
         <property name="toolTip">
          <string>Like the Windows console: starting a selection freezes the display while incoming bytes queue up. Enter copies the selection and resumes, Esc cancels. Also in View &gt; Pause Output While Selecting.</string>
         </property>
         <property name="text">
          <string>Pause output while selecting text (Enter copies, Esc cancels)</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item row="7" column="1">
        <widget class="QCheckBox" name="rightClickPastesCheck">
         <property name="toolTip">
          <string>Like cmd.exe QuickEdit: a right click pastes the clipboard, or copies the selected text when there is a selection. The context menu opens with Shift+right click, the Menu key or Shift+F10. Also in View &gt; Right Click Pastes.</string>
         </property>
         <property name="text">
          <string>Right click pastes the clipboard / copies the selection (Shift+right click opens the menu)</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabInput">
      <attribute name="title">
       <string>Input</string>
