        <layout class="QHBoxLayout" name="sshIdentityLayout">
         <item>
          <widget class="QLineEdit" name="sshIdentityEdit">
           <property name="toolTip">
            <string>Private key tried for targets typed into the SSH bar. Empty = the agent and ~/.ssh/id_ed25519, id_ecdsa, id_rsa.</string>
