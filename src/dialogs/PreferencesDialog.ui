        </widget>
       </item>
       <item row="4" column="1">
        <widget class="QComboBox" name="defaultFlowCombo"/>
       </item>
       <item row="5" column="1">
        <widget class="QCheckBox" name="dtrCheck">
         <property name="text">
          <string>Assert DTR after connecting</string>
         </property>
        </widget>
       </item>
       <item row="6" column="1">
        <widget class="QCheckBox" name="rtsCheck">
         <property name="text">
          <string>Assert RTS after connecting</string>
         </property>
        </widget>
       </item>
       <item row="7" column="1">
        <widget class="QCheckBox" name="autoReconnectCheck">
         <property name="toolTip">
          <string>Re-open the port automatically when the device disappears (board reboot, USB re-plug).</string>
         </property>
         <property name="text">
          <string>Reconnect automatically when the port disappears</string>
         </property>
        </widget>
       </item>
       <item row="8" column="0">
        <widget class="QLabel" name="reconnectIntervalLabel">
         <property name="text">
          <string>Reconnect interval:</string>
         </property>
        </widget>
       </item>
       <item row="8" column="1">
        <widget class="QSpinBox" name="reconnectIntervalSpin">
         <property name="suffix">
          <string> ms</string>
         </property>
         <property name="minimum">
          <number>200</number>
         </property>
         <property name="maximum">
          <number>60000</number>
         </property>
         <property name="singleStep">
          <number>100</number>
         </property>
         <property name="value">
          <number>1000</number>
         </property>
        </widget>
       </item>
       <item row="9" column="1">
        <widget class="QCheckBox" name="showSimulatedPortsCheck">
         <property name="toolTip">
          <string>List the built-in simulated devices (SIM:loopback, SIM:linux, SIM:uboot, SIM:mcu) in the port list so the tool can be tried without hardware.</string>
         </property>
         <property name="text">
          <string>Show simulated devices (SIM:...) in the port list</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item row="10" column="0">
        <widget class="QLabel" name="autoBaudCandidatesLabel">
         <property name="text">
          <string>Auto baud candidates:</string>
         </property>
        </widget>
       </item>
       <item row="10" column="1">
        <widget class="QLineEdit" name="autoBaudCandidatesEdit">
         <property name="toolTip">
          <string>Baud rates tried, in this order, when the baud rate is set to Auto or Session &gt; Detect Baud Rate runs. Comma-separated.</string>
         </property>
         <property name="placeholderText">
          <string notr="true">115200, 1500000, 921600, ...</string>
         </property>
        </widget>
       </item>
       <item row="11" column="0">
        <widget class="QLabel" name="autoBaudSampleLabel">
         <property name="text">
          <string>Auto baud sample time:</string>
         </property>
        </widget>
       </item>
       <item row="11" column="1">
        <widget class="QSpinBox" name="autoBaudSampleSpin">
         <property name="toolTip">
          <string>How long the detector listens at each candidate rate before judging the output.</string>
         </property>
         <property name="suffix">
          <string> ms</string>
         </property>
         <property name="minimum">
          <number>300</number>
         </property>
         <property name="maximum">
          <number>10000</number>
         </property>
         <property name="singleStep">
          <number>100</number>
         </property>
         <property name="value">
          <number>1500</number>
         </property>
        </widget>
       </item>
       <item row="12" column="1">
        <widget class="QCheckBox" name="autoBaudWatchdogCheck">
         <property name="toolTip">
          <string>While a session runs with the Auto baud rate, run the detection again when the incoming bytes stop looking like text (the board switched rates, e.g. U-Boot at 1500000 and the kernel at 115200).</string>
         </property>
         <property name="text">
          <string>Re-detect when the output turns into garbage</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabSsh">
      <attribute name="title">
